# Copy to /etc/localktv.env (root:root, mode 600). systemd reads it, not the launcher.
KTV_HOST=127.0.0.1
KTV_PORT=8080
KTV_PUBLIC_URL=https://YOUR_PUBLIC_IP
# Sub-path behind Nginx (must match deploy/nginx.conf); leave empty to serve at /.
KTV_BASE_PATH=/ktv
KTV_AUTH_REQUIRED=1
# Admin password: on first start open https://YOUR_PUBLIC_IP/ktv/setup with the setup code from
# `journalctl -u localktv` (see deploy/README.md); change it later on /admin.
# KTV_ACCESS_KEY, if present, is used ONLY as the admin password on the very first start.
KTV_COOKIE_SECURE=1
# Admin / paired-TV login lifetime, longest party, invite QR rotation.
KTV_ADMIN_DAYS=30
KTV_PARTY_HOURS=12
KTV_INVITE_MINUTES=5
KTV_DATA_DIR=/var/lib/localktv
# AI vocal separation: on as soon as onnxruntime + models/*.dyn.onnx exist (deploy/README.md).
KTV_AI_ENABLED=1
# Separate cached songs while every room has been idle this many seconds; 0 = off.
# KTV_AI_BACKFILL=1
# KTV_AI_IDLE_DELAY=300
KTV_MV=1
# Log level for journald: DEBUG / INFO (default) / WARNING.
# KTV_LOG_LEVEL=INFO
# YouTube cookies.txt (Netscape format) for yt-dlp; Oracle IPs are blocked without it.
# KTV_YT_COOKIES=/var/lib/localktv/youtube-cookies.txt
